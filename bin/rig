#!/usr/bin/env python3
"""rig - fan out shared agent-harness config to this machine.

Source of truth is this repo. `rig apply` writes generated files into each
harness home (~/.claude, ~/.codex, ...) for the current machine and records
what it wrote in ~/.rig/state.json so later runs can update, prune, and
detect hand edits.

Usage:
  rig status            show machine, harnesses, and pending changes
  rig diff              unified diff of pending changes
  rig apply [--force]   write changes; --force overwrites hand-edited targets
  rig machine           print the resolved machine name
  rig secret set NAME   store a secret value for this machine (value from stdin)
  rig secret list       show which declared secrets are present here

Secrets: global/secrets.toml declares the NAMES of secrets every machine
should carry; values never enter the repo. `rig secret set` stores them in
~/.rig/secrets.json (0600) and apply injects each one into the harness env
(claude settings.json "env", codex [shell_environment_policy.set]) so agent
shells see it. Missing values are reported by status and skipped.

Machine selection: $RIG_MACHINE, else match `hostname -s` against
machines/*/machine.toml.

Harness config: global/harness/<h>/settings.json (claude) and
global/harness/<h>/config.toml (codex), plus machines/<m>/harness/<h>/...
on top, are MERGED into the live file: rig owns only the keys/tables it
lists and leaves app-managed keys alone. Merged files never conflict.
"""
import difflib, hashlib, json, os, re, socket, sys, tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
STATE = Path(os.environ.get("RIG_STATE", "~/.rig/state.json")).expanduser()
INSTRUCTION_FILE = {"claude": "CLAUDE.md", "codex": "AGENTS.md"}
HARNESSES_RE = re.compile(r"^harnesses:\s*\[(.*)\]\s*$", re.M)


def die(msg, code=1):
    print(f"rig: {msg}", file=sys.stderr)
    sys.exit(code)


def sha(b: bytes) -> str:
    return hashlib.sha256(b).hexdigest()


# ---------- machine ----------
def load_machines():
    out = {}
    for f in sorted((ROOT / "machines").glob("*/machine.toml")):
        cfg = tomllib.loads(f.read_text())
        out[f.parent.name] = (f.parent, cfg)
    return out


def resolve_machine():
    machines = load_machines()
    want = os.environ.get("RIG_MACHINE")
    if want:
        if want not in machines:
            die(f"RIG_MACHINE={want} has no machines/{want}/machine.toml")
        return want, *machines[want]
    host = socket.gethostname().split(".")[0]
    hits = [n for n, (_, c) in machines.items() if c.get("hostname") == host]
    if len(hits) != 1:
        die(f"hostname {host!r} matched {len(hits)} machines; set RIG_MACHINE or add machines/<name>/machine.toml")
    return hits[0], *machines[hits[0]]


# ---------- skills ----------
def split_frontmatter(text: str):
    """Return (frontmatter_without_harnesses, harnesses_or_None, body)."""
    m = re.match(r"^---\n(.*?)\n---\n?(.*)$", text, re.S)
    if not m:
        die("SKILL.md has no frontmatter")
    fm, body = m.group(1), m.group(2)
    h = HARNESSES_RE.search(fm)
    harnesses = None
    if h:
        harnesses = [x.strip().strip("'\"") for x in h.group(1).split(",") if x.strip()]
        fm = HARNESSES_RE.sub("", fm).strip("\n")
    return fm, harnesses, body


def collect_skills(machine_dir):
    """name -> source dir; machine skills override global ones."""
    skills = {}
    for base in (ROOT / "global" / "skills", machine_dir / "skills"):
        if base.is_dir():
            for d in sorted(base.iterdir()):
                if (d / "SKILL.md").is_file():
                    skills[d.name] = d
    return skills


def read_fragment(p: Path) -> str:
    return p.read_text().rstrip("\n") + "\n" if p.is_file() else ""


# ---------- secrets ----------
SECRETS = STATE.parent / "secrets.json"


def declared_secrets():
    f = ROOT / "global" / "secrets.toml"
    return tomllib.loads(f.read_text()).get("secrets", {}) if f.is_file() else {}


def load_secrets():
    return json.loads(SECRETS.read_text()) if SECRETS.is_file() else {}


def missing_secrets():
    have = load_secrets()
    return [n for n in declared_secrets() if not have.get(n)]


def secret_env():
    """Declared secrets that have a value on this machine, as {NAME: value}."""
    have = load_secrets()
    return {n: have[n] for n in declared_secrets() if have.get(n)}


def cmd_secret(argv):
    sub = argv[2] if len(argv) > 2 else "list"
    if sub == "list":
        have = load_secrets()
        for n, desc in declared_secrets().items():
            print(f"  {'set    ' if have.get(n) else 'MISSING'} {n}   {desc}")
        return
    if sub == "set" and len(argv) > 3:
        name = argv[3]
        if name not in declared_secrets():
            die(f"{name} is not declared in global/secrets.toml")
        value = sys.stdin.readline().strip()
        if not value:
            die("no value on stdin; use: printf %s \"$VALUE\" | rig secret set NAME")
        SECRETS.parent.mkdir(parents=True, exist_ok=True)
        data = load_secrets(); data[name] = value
        SECRETS.write_text(json.dumps(data, indent=1, sort_keys=True) + "\n")
        SECRETS.chmod(0o600)
        print(f"stored {name} in {SECRETS}; run `rig apply` to inject it")
        return
    die("usage: rig secret list | rig secret set NAME  (value on stdin)")


# ---------- merged harness config ----------
HARNESS_CONFIG = {"claude": "settings.json", "codex": "config.toml"}


def deep_merge(base, over):
    out = dict(base)
    for k, v in over.items():
        out[k] = deep_merge(out[k], v) if isinstance(v, dict) and isinstance(out.get(k), dict) else v
    return out


def merge_json(live: str, owned: dict) -> str:
    base = json.loads(live) if live.strip() else {}
    return json.dumps(deep_merge(base, owned), indent=2) + "\n"


def toml_segments(text: str):
    """Split TOML text into (preamble_lines, [(header, lines)]) at every [table] header."""
    pre, secs, cur = [], [], None
    for line in text.splitlines(keepends=True):
        if re.match(r"^\s*\[", line):
            cur = (line.strip(), [line]); secs.append(cur)
        elif cur is None:
            pre.append(line)
        else:
            cur[1].append(line)
    return pre, secs


KEY_RE = re.compile(r"^\s*([A-Za-z0-9_.\-\"']+)\s*=")


def merge_lines(base, over):
    """Key-level merge of `k = v` lines: owned keys replace in place, new ones append, comments kept."""
    owned = {m.group(1): l for l in over if (m := KEY_RE.match(l))}
    out = []
    for l in base:
        m = KEY_RE.match(l)
        out.append(owned.pop(m.group(1)) if m and m.group(1) in owned else l)
    if owned:
        while out and not out[-1].strip():
            out.pop()
        out.extend(owned.values())
    return out


def merge_toml(live: str, owned: str) -> str:
    """Top-level keys and same-named [tables] merge key by key (owned wins).
    [[array]] tables owned by rig replace every live occurrence of that header."""
    lpre, lsecs = toml_segments(live)
    opre, osecs = toml_segments(owned)
    pre = merge_lines(lpre, opre)
    array_headers = {h for h, _ in osecs if h.startswith("[[")}
    secs = [[h, ls] for h, ls in lsecs if h not in array_headers]
    for h, ls in osecs:
        hit = next((s for s in secs if s[0] == h), None) if not h.startswith("[[") else None
        if hit:
            hit[1] = [ls[0]] + merge_lines(hit[1][1:], ls[1:])
        else:
            secs.append([h, ls])
    body = "".join(pre).rstrip("\n") + "\n"
    for h, ls in secs:
        body += "\n" + "".join(ls).rstrip("\n") + "\n"
    tomllib.loads(body)  # raises if the merge produced invalid TOML
    return body


def merged_config(h, home, machine_dir):
    fname = HARNESS_CONFIG.get(h)
    if not fname:
        return None
    srcs = [ROOT / "global" / "harness" / h / fname, machine_dir / "harness" / h / fname]
    srcs = [s for s in srcs if s.is_file()]
    if not srcs and not secret_env():
        return None
    target = home / fname
    live = target.read_text() if target.is_file() else ""
    env = secret_env()
    if fname.endswith(".json"):
        owned = {}
        for s in srcs:
            owned = deep_merge(owned, json.loads(s.read_text()))
        if env:
            owned = deep_merge(owned, {"env": env})
        return target, merge_json(live, owned)
    owned = ""
    for s in srcs:  # machine overlay merges over global before either touches the live file
        owned = merge_toml(owned, s.read_text())
    if env:
        block = "[shell_environment_policy.set]\n" + "".join(f"{k} = {json.dumps(v)}\n" for k, v in env.items())
        owned = merge_toml(owned, block)
    return target, merge_toml(live, owned)


# ---------- desired state ----------
def desired_files(name, machine_dir, cfg):
    """Return {abs_target_path: bytes} for every file rig manages on this machine."""
    harnesses = cfg.get("harnesses", {})
    if not harnesses:
        die(f"machines/{name}/machine.toml declares no [harnesses]")
    out = {}  # path -> (bytes, executable)
    shared = read_fragment(ROOT / "global" / "AGENTS.md") + read_fragment(machine_dir / "AGENTS.md")
    for h, hcfg in harnesses.items():
        home = Path(hcfg["home"]).expanduser()
        fname = INSTRUCTION_FILE.get(h)
        mc = merged_config(h, home, machine_dir)
        if mc:
            out[mc[0]] = (mc[1].encode(), False, True)
        if fname:
            extra = ""
            if h == "claude":
                extra = read_fragment(ROOT / "global" / "CLAUDE.md") + read_fragment(machine_dir / "CLAUDE.md")
            body = shared + (("\n" + extra) if extra else "")
            out[home / fname] = (body.encode(), False, False)
        for sname, sdir in collect_skills(machine_dir).items():
            fm, targets, body = split_frontmatter((sdir / "SKILL.md").read_text())
            if targets is not None and h not in targets:
                continue
            for src in sdir.rglob("*"):
                if not src.is_file() or "__pycache__" in src.parts or ".pytest_cache" in src.parts:
                    continue
                rel = src.relative_to(sdir)
                dst = home / "skills" / sname / rel
                data = (f"---\n{fm}\n---\n{body}").encode() if rel == Path("SKILL.md") else src.read_bytes()
                out[dst] = (data, os.access(src, os.X_OK), False)
    return out


# ---------- plan ----------
def load_state():
    if STATE.is_file():
        return json.loads(STATE.read_text())
    return {"machine": None, "files": {}}


def plan(desired, state):
    """Classify each path: create / update / ok / prune / conflict."""
    recorded = {Path(k): v for k, v in state["files"].items()}
    actions = []  # (kind, path, new_bytes_or_None, note)
    for p, (new, _x, merged) in desired.items():
        if merged:
            if p.is_file() and sha(p.read_bytes()) == sha(new):
                actions.append(("ok", p, None, ""))
            else:
                actions.append(("merge", p, new, "owned keys merged into live file"))
            continue
        if p.is_symlink() or any(a.is_symlink() for a in list(p.parents)[:3]):
            actions.append(("conflict", p, new, "target or ancestor is a symlink"))
            continue
        if not p.exists():
            actions.append(("create", p, new, ""))
            continue
        cur = sha(p.read_bytes())
        if cur == sha(new):
            actions.append(("ok", p, None, ""))
        elif p not in recorded:
            actions.append(("conflict", p, new, "exists but not managed by rig"))
        elif cur != recorded[p]:
            actions.append(("conflict", p, new, "hand-edited since last apply"))
        else:
            actions.append(("update", p, new, ""))
    for p, h in recorded.items():
        if p in desired:
            continue
        if not p.exists():
            actions.append(("forget", p, None, "already gone"))
        elif sha(p.read_bytes()) != h:
            actions.append(("conflict", p, None, "hand-edited; would prune"))
        else:
            actions.append(("prune", p, None, ""))
    return actions


def show(name, cfg, actions):
    print(f"machine: {name}   harnesses: {', '.join(cfg['harnesses'])}")
    for n in missing_secrets():
        print(f"  secret   {n} not set; printf %s \"$VALUE\" | bin/rig secret set {n}")
    counts = {}
    for kind, p, _, note in actions:
        counts[kind] = counts.get(kind, 0) + 1
        if kind != "ok":
            print(f"  {kind:8s} {p}" + (f"   ({note})" if note else ""))
    print("  " + "  ".join(f"{k}={v}" for k, v in sorted(counts.items())))


def cmd_diff(actions):
    for kind, p, new, _ in actions:
        if kind in ("update", "conflict") and new is not None and p.exists():
            old = p.read_text(errors="replace").splitlines(keepends=True)
            cur = new.decode(errors="replace").splitlines(keepends=True)
            sys.stdout.writelines(difflib.unified_diff(old, cur, f"{p} (current)", f"{p} (rig)"))
        elif kind == "create":
            print(f"+++ create {p}")
        elif kind == "prune":
            print(f"--- prune  {p}")


def cmd_apply(name, desired, actions, force):
    # merged config files are never recorded in state, so removing them from the repo never prunes the live file
    conflicts = [a for a in actions if a[0] == "conflict"]
    if conflicts and not force:
        show(name, {"harnesses": []}, conflicts)
        die(f"{len(conflicts)} conflict(s); inspect with `rig diff`, then `rig apply --force` to overwrite", 2)
    for kind, p, new, _ in actions:
        if kind in ("create", "update", "merge") or (kind == "conflict" and new is not None):
            p.parent.mkdir(parents=True, exist_ok=True)
            if p.is_symlink():
                p.unlink()
            p.write_bytes(new)
            if desired[p][1]:
                p.chmod(p.stat().st_mode | 0o111)
            print(f"  wrote  {p}")
        elif kind in ("prune",) or (kind == "conflict" and new is None):
            p.unlink()
            print(f"  pruned {p}")
            d = p.parent
            while d.name != "skills" and d.exists() and not any(d.iterdir()):
                d.rmdir(); d = d.parent
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps({"machine": name, "files": {str(p): sha(b) for p, (b, _x, m) in desired.items() if not m}}, indent=1, sort_keys=True))
    print(f"state: {STATE}  ({len(desired)} managed files)")


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    force = "--force" in argv
    name, mdir, cfg = resolve_machine()
    if cmd == "machine":
        print(name); return
    if cmd == "secret":
        cmd_secret(argv); return
    desired = desired_files(name, mdir, cfg)
    state = load_state()
    if state["machine"] not in (None, name):
        die(f"state file belongs to machine {state['machine']!r}, not {name!r}")
    actions = plan(desired, state)
    if cmd == "status":
        show(name, cfg, actions)
        sys.exit(2 if any(a[0] == "conflict" for a in actions) else 0)
    elif cmd == "diff":
        cmd_diff(actions)
    elif cmd == "apply":
        cmd_apply(name, desired, actions, force)
    else:
        die(__doc__)


if __name__ == "__main__":
    main(sys.argv)
